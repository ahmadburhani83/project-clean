# ==========================================================
# KONFIGURASI SUPABASE & VERCEL DEPLOYMENT
# ==========================================================

# 1. Buka dashboard Supabase (https://supabase.com)
# 2. Masuk ke Project Settings -> API
# 3. Salin URL dan anon/public key ke variabel di bawah:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Opsional) Service Role Key untuk server script admin
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
